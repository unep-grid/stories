{
  "schemaVersion": 1,
  "defaultLocale": "en",
  "title": {
    "en": "El Niño 2026: from Pacific signals to global action"
  },
  "themes": {
    "heat": {
      "background": "#030409",
      "foreground": "#f2f1ee",
      "muted": "#8b8f9c",
      "accent": "#ff6b5c",
      "accentSoft": "rgba(255, 107, 92, 0.18)",
      "surface": "#000000"
    },
    "deep": {
      "background": "#030409",
      "foreground": "#f2f1ee",
      "muted": "#8b8f9c",
      "accent": "#7fd4ff",
      "accentSoft": "rgba(127, 212, 255, 0.18)",
      "surface": "#000000"
    },
    "outlook": {
      "background": "#030409",
      "foreground": "#f2f1ee",
      "muted": "#8b8f9c",
      "accent": "#fde725",
      "accentSoft": "rgba(253, 231, 37, 0.16)",
      "surface": "#000000"
    },
    "life": {
      "background": "#030409",
      "foreground": "#f2f1ee",
      "muted": "#8b8f9c",
      "accent": "#9be38f",
      "accentSoft": "rgba(155, 227, 143, 0.18)",
      "surface": "#000000"
    }
  },
  "scenes": [
    {
      "id": "hero",
      "name": {
        "en": "El Niño 2026"
      },
      "theme": "heat",
      "layout": "intro",
      "blocks": [
        {
          "id": "hero-view",
          "type": "view",
          "slot": "stage",
          "view": "pacific-2026",
          "presentation": "background"
        },
        {
          "id": "hero-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "WMO × UNEP/GRID-Geneva · October 2026"
          },
          "heading": {
            "en": "El Niño 2026: from Pacific signals to global action"
          },
          "text": {
            "en": "A strong El Niño is under way. This is how the ocean is watched, how the warning is built, and why it reaches far beyond the Pacific."
          }
        }
      ]
    },
    {
      "id": "emerges",
      "name": {
        "en": "A strong El Niño"
      },
      "theme": "heat",
      "layout": "left",
      "blocks": [
        {
          "id": "emerges-view",
          "type": "view",
          "slot": "stage",
          "view": "nino-box",
          "presentation": "background"
        },
        {
          "id": "emerges-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Niño 3.4 index · 2026"
          },
          "heading": {
            "en": "A strong El Niño emerges"
          },
          "text": {
            "en": "The weekly Niño 3.4 sea surface temperature anomaly reached +0.8 °C in May and exceeded +3 °C by late October. The July–September Oceanic Niño Index, +2.2 °C, is the highest for that season since 1950."
          },
          "references": [
            {
              "label": {
                "en": "NOAA CPC weekly Niño indices"
              },
              "url": "https://www.cpc.ncep.noaa.gov/data/indices/wksst9120.for"
            },
            {
              "label": {
                "en": "NOAA CPC Oceanic Niño Index"
              },
              "url": "https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt"
            },
            {
              "label": {
                "en": "Copernicus Marine"
              },
              "url": "https://data.marine.copernicus.eu/product/GLOBAL_ANALYSISFORECAST_PHY_001_024/description"
            }
          ]
        },
        {
          "id": "emerges-chart",
          "type": "widget",
          "slot": "copy",
          "widget": "nino-chart",
          "config": {
            "data": "data/nino.json",
            "from": "2026-05-01"
          }
        }
      ]
    },
    {
      "id": "moorings",
      "name": {
        "en": "Watching the Pacific"
      },
      "theme": "deep",
      "layout": "right",
      "blocks": [
        {
          "id": "moorings-view",
          "type": "view",
          "slot": "stage",
          "view": "moorings",
          "presentation": "background"
        },
        {
          "id": "moorings-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "WMO Integrated Global Observing System"
          },
          "heading": {
            "en": "Watching the Pacific"
          },
          "text": {
            "en": "No single instrument sees El Niño. A line of moored buoys across the equator measures winds and the upper ocean every day; satellites map the surface; ships and radiosondes sample the air above."
          },
          "references": [
            {
              "label": {
                "en": "GTMBA / TAO-TRITON, NOAA PMEL"
              },
              "url": "https://www.pmel.noaa.gov/gtmba/"
            },
            {
              "label": {
                "en": "OceanOPS"
              },
              "url": "https://www.ocean-ops.org/"
            }
          ]
        },
        {
          "id": "moorings-key",
          "type": "widget",
          "slot": "copy",
          "widget": "platforms",
          "config": {
            "data": "data/observing.json",
            "show": [
              {
                "key": "moorings",
                "color": "#f2f1ee",
                "label": "TAO/TRITON mooring sites across the tropical Pacific (nominal array)"
              },
              {
                "key": "satellites",
                "color": "#ff6b5c",
                "label": "Satellites: sea surface temperature, height and winds, every day"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "argo",
      "name": {
        "en": "Argo floats"
      },
      "theme": "deep",
      "layout": "right",
      "blocks": [
        {
          "id": "argo-view",
          "type": "view",
          "slot": "stage",
          "view": "argo",
          "presentation": "background"
        },
        {
          "id": "argo-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Ocean interior · last 10 days"
          },
          "heading": {
            "en": "Thousands of floats, down to 2,000 metres"
          },
          "text": {
            "en": "Argo floats drift with the currents, dive to 2,000 m and surface to send profiles of temperature and salinity. Shared through WMO within hours, they reveal where El Niño stores its heat: below the surface."
          },
          "references": [
            {
              "label": {
                "en": "Argo Global Data Assembly Centre"
              },
              "url": "https://data-argo.ifremer.fr/"
            },
            {
              "label": {
                "en": "OceanOPS"
              },
              "url": "https://www.ocean-ops.org/"
            }
          ]
        },
        {
          "id": "argo-key",
          "type": "widget",
          "slot": "copy",
          "widget": "platforms",
          "config": {
            "data": "data/observing.json",
            "show": [
              {
                "key": "argo",
                "color": "#7fd4ff",
                "label": "Argo floats"
              },
              {
                "key": "moorings",
                "color": "#f2f1ee",
                "label": "TAO/TRITON mooring sites"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "winds",
      "name": {
        "en": "Trade winds falter"
      },
      "theme": "deep",
      "layout": "left",
      "blocks": [
        {
          "id": "winds-view",
          "type": "view",
          "slot": "stage",
          "view": "winds",
          "presentation": "background"
        },
        {
          "id": "winds-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Walker circulation · schematic"
          },
          "heading": {
            "en": "The trade winds falter"
          },
          "text": {
            "en": "Normally the trade winds push warm water west, piling it up near Indonesia. As they weaken, that warm water flows back east, which weakens the winds further: ocean and atmosphere lock each other into El Niño."
          },
          "references": [
            {
              "label": {
                "en": "NOAA Climate.gov"
              },
              "url": "https://www.climate.gov/news-features/blogs/enso/walker-circulation-ensos-atmospheric-buddy"
            },
            {
              "label": {
                "en": "Copernicus Marine L4 sea surface wind"
              },
              "url": "https://data.marine.copernicus.eu/product/WIND_GLO_PHY_L4_NRT_012_004/description"
            }
          ]
        },
        {
          "id": "winds-walker",
          "type": "widget",
          "slot": "stage",
          "widget": "walker3d"
        }
      ]
    },
    {
      "id": "remembers",
      "name": {
        "en": "The ocean remembers"
      },
      "theme": "heat",
      "layout": "left",
      "blocks": [
        {
          "id": "remembers-view",
          "type": "view",
          "slot": "stage",
          "view": "remembers-close",
          "presentation": "background"
        },
        {
          "id": "remembers-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Equatorial Pacific · surface to 400 m"
          },
          "heading": {
            "en": "The ocean remembers"
          },
          "text": {
            "en": "Below the surface, the warm layer has thickened across the east. The 20 °C line, which marks the thermocline, now lies near 150 m where it was at 20–70 m a year ago, cutting off the cold water that usually wells up."
          },
          "references": [
            {
              "label": {
                "en": "Copernicus Marine global ocean analysis"
              },
              "url": "https://data.marine.copernicus.eu/product/GLOBAL_ANALYSISFORECAST_PHY_001_024/description"
            }
          ]
        },
        {
          "id": "remembers-section",
          "type": "widget",
          "slot": "stage",
          "widget": "section",
          "config": {
            "data": "data/section.json"
          }
        }
      ]
    },
    {
      "id": "forecasts",
      "name": {
        "en": "Forecasts"
      },
      "theme": "outlook",
      "layout": "left",
      "blocks": [
        {
          "id": "forecasts-view",
          "type": "view",
          "slot": "stage",
          "view": "forecast-south",
          "presentation": "background"
        },
        {
          "id": "forecasts-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "WMO Long-Range Forecast system"
          },
          "heading": {
            "en": "From observations to forecasts"
          },
          "text": {
            "en": "Observations shared by WMO Members feed daily analyses and coupled ocean–atmosphere models. The WMO Lead Centre combines forecasts from centres worldwide into a multi-model ensemble, representing a range of possible outcomes to inform seasonal outlooks."
          },
          "references": [
            {
              "label": {
                "en": "WMO El Niño / La Niña"
              },
              "url": "https://wmo.int/topics/el-nino-la-nina"
            },
            {
              "label": {
                "en": "WMO Lead Centre for Long-Range Forecast Multi-Model Ensemble"
              },
              "url": "https://www.wmolc.org/"
            }
          ]
        },
        {
          "id": "forecasts-pipeline",
          "type": "widget",
          "slot": "stage",
          "widget": "pipeline",
          "config": {
            "steps": [
              {
                "title": "Observe",
                "text": "Satellites, moorings, Argo floats, ships and radiosondes, exchanged through WMO"
              },
              {
                "title": "Analyse",
                "text": "Ocean and atmosphere analyses assimilate them every day"
              },
              {
                "title": "Model",
                "text": "Coupled models of Global Producing Centres run seasonal ensembles"
              },
              {
                "title": "Combine",
                "text": "The WMO Lead Centre merges them into a multi-model ensemble"
              },
              {
                "title": "Communicate",
                "text": "WMO El Niño/La Niña Update and Global Seasonal Climate Update"
              }
            ],
            "outcome": "Seasonal outlook pending confirmation from a dated WMO Update, including its target season and probabilities."
          }
        }
      ]
    },
    {
      "id": "regional",
      "name": {
        "en": "Regional realities"
      },
      "theme": "outlook",
      "layout": "right",
      "blocks": [
        {
          "id": "regional-view",
          "type": "view",
          "slot": "stage",
          "view": "rainfall-signal",
          "presentation": "background"
        },
        {
          "id": "regional-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Rainfall · historical El Niño signal"
          },
          "heading": {
            "en": "One signal, many regional realities"
          },
          "text": {
            "en": "Historically, El Niño has increased the likelihood of drier conditions in parts of Indonesia, northern Australia, southern Africa and Central America, and wetter conditions along the Ecuador–Peru coast, in equatorial East Africa and south-eastern South America, in particular seasons. The map labels show those seasons. Individual events differ, and other climate drivers influence outcomes. Regional Climate Centres and national services translate global outlooks into local forecasts and warnings. These schematic regions await WMO validation; the 2026 seasonal outlook is pending confirmation."
          },
          "references": [
            {
              "label": {
                "en": "Ropelewski & Halpert (1987), Mon. Wea. Rev. 115"
              },
              "url": "https://doi.org/10.1175/1520-0493(1987)115%3C1606:GARSPP%3E2.0.CO;2"
            },
            {
              "label": {
                "en": "NOAA CPC, ENSO cycle"
              },
              "url": "https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/ensocycle/enso_cycle.shtml"
            },
            {
              "label": {
                "en": "WMO Lead Centre, Global Seasonal Climate Update"
              },
              "url": "https://www.wmolc.org/"
            }
          ]
        }
      ]
    },
    {
      "id": "reefs",
      "name": {
        "en": "Coral heat stress"
      },
      "theme": "heat",
      "layout": "left",
      "blocks": [
        {
          "id": "reefs-view",
          "type": "view",
          "slot": "stage",
          "view": "reefs",
          "presentation": "background"
        },
        {
          "id": "reefs-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Degree Heating Weeks · August to October 2026"
          },
          "heading": {
            "en": "Heat reaches the reefs"
          },
          "text": {
            "en": "Corals bleach when heat builds up over weeks. At 4 °C-weeks and above, significant bleaching is likely; at 8 °C-weeks and above, severe bleaching and increased risk of coral mortality. Responses vary with species and local conditions. Explore the thermal exposure shown across the Pacific."
          },
          "references": [
            {
              "label": {
                "en": "NOAA Coral Reef Watch"
              },
              "url": "https://coralreefwatch.noaa.gov/product/5km/index_5km_dhw.php"
            }
          ]
        }
      ]
    },
    {
      "id": "peru",
      "name": {
        "en": "Upwelling off Peru"
      },
      "theme": "life",
      "layout": "right",
      "blocks": [
        {
          "id": "peru-view",
          "type": "view",
          "slot": "stage",
          "view": "peru",
          "presentation": "background"
        },
        {
          "id": "peru-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Chlorophyll-a · Humboldt Current"
          },
          "heading": {
            "en": "When upwelling weakens, food webs can change"
          },
          "text": {
            "en": "Off Peru and Ecuador, cold, nutrient-rich water usually rises and supports productive fisheries. During El Niño, weaker upwelling can reduce nutrient supply and phytoplankton productivity. Chlorophyll-a is an indicator of phytoplankton abundance. Fisheries also depend on management, stock status and other oceanographic processes."
          },
          "references": [
            {
              "label": {
                "en": "Copernicus Marine biogeochemistry"
              },
              "url": "https://data.marine.copernicus.eu/product/GLOBAL_ANALYSISFORECAST_BGC_001_028/description"
            }
          ]
        }
      ]
    },
    {
      "id": "early-warning",
      "name": {
        "en": "Early warning"
      },
      "theme": "deep",
      "layout": "intro",
      "blocks": [
        {
          "id": "early-warning-view",
          "type": "view",
          "slot": "stage",
          "view": "world-outro",
          "presentation": "background"
        },
        {
          "id": "early-warning-copy",
          "type": "copy",
          "slot": "copy",
          "label": {
            "en": "Early Warnings for All"
          },
          "heading": {
            "en": "Early warning turns knowledge into time"
          },
          "text": {
            "en": "A forecast only matters if it reaches people in time to act. Monitoring, forecasting, clear warnings and preparedness help communities turn climate information into timely decisions."
          },
          "references": [
            {
              "label": {
                "en": "WMO Early Warnings for All"
              },
              "url": "https://wmo.int/activities/early-warnings-all"
            }
          ]
        }
      ]
    }
  ]
}
